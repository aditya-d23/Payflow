# Copy to .env (git-ignored) and adjust. Never commit real values.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/payflow
DB_USERNAME=payflow
DB_PASSWORD=change-me

# Local-only HS256 signing key for scripts/dev-token.sh (>= 32 bytes):
#   openssl rand -base64 48
PAYFLOW_JWT_SECRET=
PAYFLOW_JWT_ISSUER=payflow-local
PAYFLOW_JWT_AUDIENCE=payflow-api
# Production: your identity provider's JWKS endpoint (HMAC is disabled in prod).
PAYFLOW_JWT_JWK_SET_URI=
